
# IMPORTANTE:
# Este archivo es una plantilla.
# No debe contener valores reales.
# Copiar a `.env` y completar con valores del entorno.

# ============================================================================
# CONTEXTO DE EJECUCIÓN
# ============================================================================
# Define el dominio, proyecto y ambiente activo
# utilizado por el framework para resolver
# variables dinámicas de configuración.
#
# Convención utilizada:
# DOMAIN_PROJECT_ENV_VARIABLE
#
# Ejemplo:
# PAYS_BPAGOS_CERT_URL
# ============================================================================

DOMAIN=
PROJECT=
ENV=

# ============================================================================
# DOMINIO: PAYS | PROYECTO: BPAGOS | AMBIENTE: CERT
# ============================================================================
# Configuración principal del BackOffice PayStudio
PAYS_BPAGOS_CERT_URL=

# URL del Portal de Comercio
PAYS_BPAGOS_CERT_PORTAL_URL=

# Credenciales principales del BackOffice
PAYS_BPAGOS_CERT_USER=
PAYS_BPAGOS_CERT_PASS=

# Credenciales administrativas del Portal
PAYS_BPAGOS_CERT_PORTAL_SUPERADMIN_USER=
PAYS_BPAGOS_CERT_PORTAL_SUPERADMIN_PASS=

# Configuración de base de datos
PAYS_BPAGOS_CERT_DB_SERVER=
PAYS_BPAGOS_CERT_DB_NAME=
PAYS_BPAGOS_CERT_DB_USER=
PAYS_BPAGOS_CERT_DB_PASS=

# ============================================================================
# DOMINIO: PAYS | PROYECTO: BPAGOS | AMBIENTE: EVO
# ============================================================================
PAYS_BPAGOS_EVO_URL=
PAYS_BPAGOS_EVO_PORTAL_URL=

PAYS_BPAGOS_EVO_USER=
PAYS_BPAGOS_EVO_PASS=

PAYS_BPAGOS_EVO_PORTAL_SUPERADMIN_USER=
PAYS_BPAGOS_EVO_PORTAL_SUPERADMIN_PASS=

PAYS_BPAGOS_EVO_DB_SERVER=
PAYS_BPAGOS_EVO_DB_NAME=
PAYS_BPAGOS_EVO_DB_USER=
PAYS_BPAGOS_EVO_DB_PASS=

# ============================================================================
# DOMINIO: PAYS | PROYECTO: BPAGOS | AMBIENTE: FUTURE
# ============================================================================
PAYS_BPAGOS_FUTURE_URL=
PAYS_BPAGOS_FUTURE_PORTAL_URL=

PAYS_BPAGOS_FUTURE_USER=
PAYS_BPAGOS_FUTURE_PASS=

PAYS_BPAGOS_FUTURE_PORTAL_SUPERADMIN_USER=
PAYS_BPAGOS_FUTURE_PORTAL_SUPERADMIN_PASS=

PAYS_BPAGOS_FUTURE_DB_SERVER=
PAYS_BPAGOS_FUTURE_DB_NAME=
PAYS_BPAGOS_FUTURE_DB_USER=
PAYS_BPAGOS_FUTURE_DB_PASS=

# ============================================================================
# DOMINIO: PAYS | PROYECTO: GETNET | AMBIENTE: CERT
# ============================================================================
PAYS_GETNET_CERT_URL=
PAYS_GETNET_CERT_PORTAL_URL=

PAYS_GETNET_CERT_USER=
PAYS_GETNET_CERT_PASS=

PAYS_GETNET_CERT_PORTAL_SUPERADMIN_USER=
