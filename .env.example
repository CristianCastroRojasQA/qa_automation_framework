# Credenciales administrativas del Portal
PAYS_BPAGOS_EVO_PORTAL_SUPERADMIN_USER=
PAYS_BPAGOS_EVO_PORTAL_SUPERADMIN_PASS=

# Credenciales de conexión a base de datos
PAYS_BPAGOS_EVO_DB_SERVER=
PAYS_BPAGOS_EVO_DB_NAME=
PAYS_BPAGOS_EVO_DB_USER=
PAYS_BPAGOS_EVO_DB_PASS=

# Credenciales para pruebas de seguridad - Inactividad
PAYS_BPAGOS_EVO_AUTH_INACTIVITY_USER=
PAYS_BPAGOS_EVO_AUTH_INACTIVITY_PASS=


# ============================================================================
# DOMINIO: PAYS | PROYECTO: BPAGOS | AMBIENTE: FUTURE
# ============================================================================
# Configuración principal del BackOffice PayStudio
PAYS_BPAGOS_FUTURE_URL=

# URL del Portal de Comercio
PAYS_BPAGOS_FUTURE_PORTAL_URL=

# Credenciales principales del BackOffice
PAYS_BPAGOS_FUTURE_USER=
PAYS_BPAGOS_FUTURE_PASS=

# Credenciales administrativas del Portal
PAYS_BPAGOS_FUTURE_PORTAL_SUPERADMIN_USER=
PAYS_BPAGOS_FUTURE_PORTAL_SUPERADMIN_PASS=

# Credenciales de apoyo para pruebas del BackOffice
