# ============================================================================
# DOMINIO: PAYS | PROYECTO: GETNET | AMBIENTE: CERT
# ============================================================================
# Configuración principal del BackOffice PayStudio
PAYS_GETNET_CERT_URL=

# URL del Portal de Comercio
PAYS_GETNET_CERT_PORTAL_URL=

# Credenciales principales del BackOffice
PAYS_GETNET_CERT_USER=
PAYS_GETNET_CERT_PASS=

# Credenciales de apoyo para pruebas del BackOffice
PAYS_GETNET_CERT_REUSED_PREVIOUS_PASSWORD=
PAYS_GETNET_CERT_VALID_NEW_PASSWORD=

# Credenciales administrativas del Portal
PAYS_GETNET_CERT_PORTAL_SUPERADMIN_USER=
PAYS_GETNET_CERT_PORTAL_SUPERADMIN_PASS=

# Credenciales de conexión a base de datos
PAYS_GETNET_CERT_DB_SERVER=
PAYS_GETNET_CERT_DB_NAME=
PAYS_GETNET_CERT_DB_USER=
PAYS_GETNET_CERT_DB_PASS=


# ============================================================================
# CONFIGURACIÓN DEL SISTEMA DE LOGS
# ============================================================================
# Nivel de detalle del logger:
# silly | debug | info | warn | error
LOG_LEVEL=info

# Tamaño máximo por archivo rotativo
LOG_MAX_SIZE=10m

# Cantidad máxima de archivos históricos
LOG_MAX_FILES=14d

# Directorio de almacenamiento de logs
LOG_DIR=logs


# ============================================================================
# CONFIGURACIÓN DE EJECUCIÓN PLAYWRIGHT
# ============================================================================
# Habilita o deshabilita ejecución en paralelo.
# Valores esperados: true | false
PLAYWRIGHT_PARALLEL=false

# Cantidad de workers a utilizar cuando el paralelismo está habilitado.
PLAYWRIGHT_WORKERS=1


# ============================================================================
# CONFIGURACIÓN DEL NAVEGADOR PLAYWRIGHT
# ============================================================================
# Navegador a utilizar en ejecución local.
# Valores esperados: chromium | firefox | webkit
PLAYWRIGHT_BROWSER=chromium


# ============================================================================
# CONFIGURACIÓN DE VISIBILIDAD DEL NAVEGADOR
# ============================================================================
# Define si Playwright debe ejecutar el navegador en modo headless.
# Valores esperados: true | false
PLAYWRIGHT_HEADLESS=true